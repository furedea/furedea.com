{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "ignorePatterns": [
    ".astro",
    "coverage",
    "dist",
    "node_modules",
    "playwright-report",
    "test-results"
  ]
}
