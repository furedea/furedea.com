---
import "@fontsource-variable/inter/wght.css";
import "@styles/global.css";
import type { Lang } from "@i18n/ui";
import { useTranslations } from "@i18n/utils";
import SeoHead from "@components/seo_head.astro";
import Header from "@components/header.astro";
import Footer from "@components/footer.astro";
import type { SocialPreview } from "@data/site";

interface Props {
  title: string;
  description: string;
  lang: Lang;
  noindex?: boolean;
  socialPreview?: SocialPreview;
  socialPreviewAlt?: string;
  ogType?: "website" | "article";
}

const {
  title,
  description,
  lang,
  noindex = false,
  socialPreview,
  socialPreviewAlt,
  ogType,
} = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead
      title={title}
      description={description}
      lang={lang}
      noindex={noindex}
      socialPreview={socialPreview}
      socialPreviewAlt={socialPreviewAlt}
      ogType={ogType}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t("common.skipToContent")}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
