---
import type { Lang } from "@i18n/ui";
import { useTranslations, pickLocale } from "@i18n/utils";
import { education } from "@data/education";
import Section from "./section.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="about" title={t("section.about")}>
  <h3 class="sub-heading">{t("about.education")}</h3>
  <ul class="timeline">
    {
      education.map((entry) => (
        <li class="timeline-item">
          <span class="year">{entry.year}</span>
          <div>
            <p class="degree">{pickLocale(entry.institution, lang)}</p>
            <p class="institution">{pickLocale(entry.detail, lang)}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .sub-heading {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .timeline {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .timeline-item {
    display: flex;
    gap: 1.5rem;
    align-items: baseline;
  }

  .year {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-accent);
    white-space: nowrap;
    min-width: 6rem;
  }

  .degree {
    font-weight: 500;
    color: var(--color-text-primary);
  }

  .institution {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }
</style>
