---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<h2 id={id} class="section-heading">{title}</h2>

<style>
  .section-heading {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }
</style>
