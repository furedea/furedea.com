---
import type { SocialIcon } from "@data/profile";

interface Props {
  href: string;
  label: string;
  icon: SocialIcon;
}

const { href, label, icon } = Astro.props;

const ICON_PATHS: Record<SocialIcon, string> = {
  github:
    "M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.38-3.37-1.38-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.37 9.37 0 0 1 12 6.99c.85 0 1.7.12 2.5.34 1.9-1.33 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.15 10.15 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z",
  x: "M17.53 3h3.06l-6.68 7.64L21.77 21h-6.16l-4.82-6.3L5.28 21H2.22l7.14-8.16L1.82 3h6.31l4.35 5.75L17.53 3Zm-1.07 16.18h1.7L7.2 4.72H5.38l11.08 14.46Z",
  zenn: "M4.7 18.5 15.73 3h3.57L8.27 18.5H4.7Zm8.2 0L19.3 9.5v9h-6.4Z",
};
---

<a class="icon-link" href={href} target="_blank" rel="noopener noreferrer" aria-label={label}>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d={ICON_PATHS[icon]} />
  </svg>
</a>

<style>
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    text-decoration: none;
    transition:
      color 0.15s,
      border-color 0.15s,
      transform 0.15s;

    &:hover {
      color: var(--color-accent);
      border-color: var(--color-accent);
      transform: translateY(-2px);
    }
  }

  svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: currentColor;
  }
</style>
