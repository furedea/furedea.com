---
import type { Lang } from "@i18n/ui";
import { useTranslations, pickLocale } from "@i18n/utils";
import { works } from "@data/works";
import Section from "./section.astro";
import TagList from "./tag_list.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="works" title={t("section.works")}>
  <div class="card-grid works-grid">
    {
      works.map((work) => (
        <a class="work-card" href={work.url}>
          <h3>{pickLocale(work.title, lang)}</h3>
          <p>{pickLocale(work.description, lang)}</p>
          <TagList tags={work.tags} />
        </a>
      ))
    }
  </div>
</Section>

<style>
  .works-grid {
    --card-min: 20rem;
  }

  .work-card {
    display: block;
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s,
      transform 0.15s;

    &:hover {
      border-color: var(--color-accent);
      transform: translateY(-2px);
    }
  }

  .work-card h3 {
    color: var(--color-text-primary);
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    transition: color 0.15s;
  }

  .work-card:hover h3 {
    color: var(--color-accent);
  }

  .work-card p {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }
</style>
