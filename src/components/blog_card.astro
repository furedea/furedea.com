---
import type { Lang } from "@i18n/ui";
import { getLocalizedPath, getDateLocale } from "@i18n/utils";
import { createArticleCover } from "@data/article_cover";
import type { WebsiteArticleMetadata } from "@data/article";
import ArticleCover from "./article_cover.astro";
import TagList from "./tag_list.astro";

interface Props extends Pick<WebsiteArticleMetadata, "title" | "date" | "emoji" | "type" | "tags"> {
  slug: string;
  lang: Lang;
}

const { title, date, emoji, type, tags, slug, lang } = Astro.props;
const formattedDate = date.toLocaleDateString(getDateLocale(lang), {
  year: "numeric",
  month: "short",
  day: "numeric",
});
const href = getLocalizedPath(`/blog/${slug}/`, lang);
const cover = createArticleCover(slug, { title, emoji, type, tags });
---

<a class="blog-card" href={href}>
  <ArticleCover cover={cover} />
  <div class="card-body">
    <time datetime={date.toISOString()}>{formattedDate}</time>
    <h3>{title}</h3>
    {tags.length > 0 && <TagList tags={tags} />}
  </div>
</a>

<style>
  .blog-card {
    display: block;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s,
      transform 0.15s;

    &:hover {
      border-color: var(--color-accent);
      transform: translateY(-2px);
    }
  }

  .card-body {
    padding: 1.25rem;
  }

  time {
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
  }

  h3 {
    color: var(--color-text-primary);
    font-size: 1.125rem;
    margin: 0.5rem 0;
    transition: color 0.15s;
  }

  .blog-card:hover h3 {
    color: var(--color-accent);
  }

</style>
