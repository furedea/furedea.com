---
import type { Publication } from "@data/publications";
import OptionalLink from "./optional_link.astro";

interface Props {
  pub: Publication;
}

const { pub } = Astro.props;
---

<li class="pub-entry">
  <p class="pub-title">
    <OptionalLink href={pub.url}>{pub.title}</OptionalLink>
  </p>
  <p class="pub-authors">{pub.authors}</p>
  <p class="pub-venue">
    {pub.venueShort ?? pub.venue}, {pub.year}
  </p>
  <div class="pub-links">
    {pub.pdfUrl && <a href={pub.pdfUrl} rel="noopener">PDF</a>}
    {pub.slidesUrl && <a href={pub.slidesUrl} rel="noopener">Slides</a>}
  </div>
</li>

<style>
  .pub-entry {
    padding: 1rem 0;
  }

  .pub-entry + .pub-entry {
    border-top: 1px solid var(--color-border);
  }

  .pub-title {
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .pub-authors {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .pub-venue {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .pub-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.375rem;

    a {
      font-size: 0.8125rem;
      font-family: var(--font-mono);
    }
  }
</style>
