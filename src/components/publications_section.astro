---
import type { Lang } from "@i18n/ui";
import { useTranslations } from "@i18n/utils";
import { getNews } from "@data/news";
import { getPublications } from "@data/publications";
import Section from "./section.astro";
import NewsEntry from "./news_entry.astro";
import PublicationEntry from "./publication_entry.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const publications = await getPublications(lang);
const news = await getNews();
---

<Section id="publications" title={t("section.publications")}>
  {
    publications.length > 0 ? (
      <ul class="pub-list">
        {publications.map((pub) => (
          <PublicationEntry pub={pub} lang={lang} />
        ))}
      </ul>
    ) : (
      <p class="empty">{t("publications.empty")}</p>
    )
  }
  {
    news.length > 0 && (
      <ul class="news-list">
        {news.map((item) => (
          <NewsEntry item={item} lang={lang} />
        ))}
      </ul>
    )
  }
</Section>

<style>
  .pub-list,
  .news-list {
    list-style: none;
  }

  .news-list {
    margin-top: 1.5rem;
  }

  .empty {
    color: var(--color-text-secondary);
  }
</style>
