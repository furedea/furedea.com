---
import type { Lang } from "@i18n/ui";
import { formatActivityPeriod, type Activity } from "@data/activities";
import { pickLocale, useTranslations } from "@i18n/utils";
import OptionalLink from "./optional_link.astro";

interface Props {
  item: Activity;
  lang: Lang;
}

const { item, lang } = Astro.props;
const t = useTranslations(lang);
const title = pickLocale(item.title, lang);
---

<li class="activity-entry">
  <time datetime={item.date}>{formatActivityPeriod(item)}</time>
  <span class={`badge badge-${item.type}`}>{t(`activity.type.${item.type}`)}</span>
  <span class="activity-title"><OptionalLink href={item.url}>{title}</OptionalLink></span>
</li>

<style>
  .activity-entry {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: baseline;
    row-gap: 0.25rem;
    padding: 0.5rem 0;
  }

  time {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .badge {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.0625rem 0.375rem;
    border-radius: 0.1875rem;
    white-space: nowrap;
    text-align: center;
    color: var(--color-bg);
    background: var(--color-text-secondary);
  }

  .badge-paper {
    background: var(--color-accent);
  }

  .badge-award {
    background: #f5a623;
  }

  .badge-talk {
    background: #7c8cf5;
  }

  .badge-selection {
    background: #f5a623;
  }

  .badge-study-abroad {
    background: #f28cb1;
  }

  @media (width < 640px) {
    .activity-title {
      grid-column: 1 / -1;
    }
  }
</style>
