---
import type { Lang } from "@i18n/ui";
import { languages } from "@i18n/ui";
import BaseLayout from "@layouts/base_layout.astro";
import HeroSection from "@components/hero_section.astro";
import AboutSection from "@components/about_section.astro";
import ResearchSection from "@components/research_section.astro";
import PublicationsSection from "@components/publications_section.astro";
import NewsSection from "@components/news_section.astro";
import BlogSection from "@components/blog_section.astro";
import ContactSection from "@components/contact_section.astro";
import { getVisibleHomeSections, type HomeSectionId } from "@data/sections";
import { getHomeTitle, site } from "@data/site";
import { createProfilePageJsonLd } from "@data/structured_data";
import { getLocalizedPath, pickLocale } from "@i18n/utils";

type SectionComponent = (typeof sectionComponents)[HomeSectionId];

const sectionComponents = {
  about: AboutSection,
  research: ResearchSection,
  publications: PublicationsSection,
  news: NewsSection,
  blog: BlogSection,
  contact: ContactSection,
} as const satisfies Record<HomeSectionId, unknown>;

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({
    params: { lang },
  }));
}

const lang = Astro.params.lang as Lang;
const sections = getVisibleHomeSections();
const pageUrl = new URL(getLocalizedPath("/", lang), Astro.site ?? Astro.url).href;
const structuredData = createProfilePageJsonLd(lang, pageUrl);
---

<BaseLayout
  title={getHomeTitle()}
  description={pickLocale(site.homeDescription, lang)}
  lang={lang}
  structuredData={structuredData}
>
  <HeroSection lang={lang} />
  {
    sections.map((id) => {
      const Section = sectionComponents[id] as SectionComponent;
      return <Section lang={lang} />;
    })
  }
</BaseLayout>
