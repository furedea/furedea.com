---
import BaseLayout from "@layouts/base_layout.astro";
import { getPageTitle, site } from "@data/site";

const japanese = site.notFound.ja;
const english = site.notFound.en;
---

<BaseLayout
  title={getPageTitle("404")}
  description={japanese.description}
  lang="ja"
  noindex
  languagePath="/"
>
  <section class="not-found">
    <div class="container">
      <div class="not-found-card">
        <p class="error-code" aria-hidden="true">404</p>
        <div class="message">
          <p class="eyebrow">Page not found</p>
          <h1>{japanese.heading}</h1>
          <p>{japanese.description}</p>
          <p lang="en">
            <strong>{english.heading}.</strong> {english.description}
          </p>
        </div>
        <nav class="home-links" aria-label="Home pages">
          <a class="primary-link" href="/ja/">{japanese.homeLabel}</a>
          <a class="secondary-link" href="/en/" lang="en">{english.homeLabel}</a>
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100svh - var(--header-height));
    padding-top: calc(var(--header-height) + 4rem);
    padding-bottom: 4rem;
    display: grid;
    align-items: center;
  }

  .not-found-card {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 6vw, 4rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
  }

  .not-found-card::after {
    content: "";
    position: absolute;
    right: -5rem;
    bottom: -8rem;
    width: 20rem;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    border-radius: 50%;
    pointer-events: none;
  }

  .error-code {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: clamp(4.5rem, 18vw, 9rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.08em;
    opacity: 0.16;
  }

  .message {
    position: relative;
    z-index: 1;
    max-width: 38rem;
    margin-top: -1.5rem;
  }

  .eyebrow {
    margin-bottom: 0.5rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 1rem;
    font-size: clamp(1.75rem, 5vw, 2.75rem);
  }

  .message > p:not(.eyebrow) {
    color: var(--color-text-secondary);
  }

  .message > p + p {
    margin-top: 0.5rem;
  }

  .home-links {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .home-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.625rem 1rem;
    border: 1px solid var(--color-accent);
    border-radius: 0.375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .primary-link {
    color: var(--color-bg);
    background: var(--color-accent);
  }

  .secondary-link {
    color: var(--color-accent);
  }

  .home-links a:hover {
    filter: brightness(1.08);
  }
</style>
