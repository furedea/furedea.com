---
import { getLocalizedPath } from "@i18n/utils";
import { createWebSiteJsonLd, serializeJsonLd } from "@data/structured_data";
import { BASE_PATH } from "../consts";

const redirectPath = getLocalizedPath("/", "ja");
const pageUrl = new URL("/", Astro.site ?? Astro.url).href;
const structuredData = createWebSiteJsonLd(pageUrl);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${redirectPath}`} />
    <link rel="canonical" href={redirectPath} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${BASE_PATH}/favicon.png`} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={`${BASE_PATH}/favicon.svg`} />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${BASE_PATH}/apple_touch_icon.png`}
    />
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
    <title>Redirecting...</title>
  </head>
  <body>
    <p>
      Redirecting to <a href={redirectPath}>{redirectPath}</a>
    </p>
  </body>
</html>
