{
  "name": "furedea.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "article:new": "node scripts/new_article.ts",
    "article:preview": "pnpm dlx zenn-cli@0.5.2 preview",
    "article:export:esa": "node scripts/export_esa.ts",
    "format": "oxfmt 'src/**/*.ts' 'scripts/**/*.ts' '*.ts' --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check 'src/**/*.ts' 'scripts/**/*.ts' '*.ts' --no-error-on-unmatched-pattern",
    "lint": "oxlint src scripts astro.config.ts playwright.config.ts vitest.config.ts --deny-warnings",
    "lint:fix": "oxlint src scripts astro.config.ts playwright.config.ts vitest.config.ts --fix",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "knip": "knip",
    "knip:production": "knip --production",
    "verify:build": "node scripts/verify_build.mjs",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run knip && pnpm run build && pnpm run verify:build",
    "check:e2e": "pnpm run build && pnpm run test:e2e",
    "check:full": "pnpm run check && pnpm run test:e2e"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/inter": "^5.2.8",
    "astro": "^7.1.0",
    "mermaid": "^11.16.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "knip": "^6.4.1",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "vitest": "^4.1.3"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.13",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.5",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "sharp": "0.35.3",
      "svgo": "4.0.2",
      "vite": "8.2.0",
      "yaml": "2.8.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
